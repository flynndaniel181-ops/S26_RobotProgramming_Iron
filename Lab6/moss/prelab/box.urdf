<?xml version="1.0"?>
<robot name="box">
	<material name="spring">
		<color rgba="0.5 0.5 0.5 1.0"/>
	</material>
	<link name="base_link">
		<visual>
			<geometry>
				<box size="1 1 0.05"/>
			</geometry>
			<origin xyz="0 0 0" rpy="0 0 0"/>
		</visual>
	</link>
	<link name="top_link">
		<visual>
			<geometry>
				<box size="1 1 0.05"/>
			</geometry>
			<origin xyz="0.5 0 0" rpy="0 0 0"/>
		</visual>
	</link>
	<joint name = "top_to_back" type = "revolute">
		<axis rpy="0 0 0" xyz="0 -1 0"/>
		<parent link="back_link"/>
		<child link="top_link"/>
		<limit effort="1000.0" lower="0" upper="1.57" velocity="0.5"/>
		<origin rpy="0 0 0" xyz="0 0 1"/>
	</joint>
	<link name="right_link">
		<visual>
			<geometry>
				<box size="1 1 0.05"/>
			</geometry>
			<origin xyz="0 0 0.5" rpy="1.5708 0 0"/>
		</visual>
	</link>

	<joint name="right_to_bottom" type="fixed">
  		<parent link="base_link"/>
  		<child link="right_link"/>
  		<origin rpy="0 0 0" xyz="0 0.5 0"/>
	</joint>
        <link name="left_link">
                <visual>
                        <geometry>
                                <box size="1 1 0.05"/>
                        </geometry>
                        <origin xyz="0 0 0.5" rpy="-1.5708 0 0"/>
                </visual>
        </link>

        <joint name="left_to_bottom" type="fixed">
                <parent link="base_link"/>
                <child link="left_link"/>
                <origin rpy="0 0 0" xyz="0 -0.5 0"/>
        </joint>
        <link name="back_link">
                <visual>
                        <geometry>
                                <box size="1 1 0.05"/>
                        </geometry>
                        <origin xyz="0 0 0.5" rpy="0 1.5708 0"/>
                </visual>
        </link>

        <joint name="back_to_bottom" type="fixed">
                <parent link="base_link"/>
                <child link="back_link"/>
                <origin rpy="0 0 0" xyz="-0.5 0 0"/>
        </joint>
        <link name="front_link">
                <visual>
                        <geometry>
                                <box size="1 1 0.05"/>
                        </geometry>
                        <origin xyz="0 0 0.5" rpy="0 -1.5708 0"/>
                </visual>
        </link>

        <joint name="front_to_bottom" type="fixed">
                <parent link="base_link"/>
                <child link="front_link"/>
                <origin rpy="0 0 0" xyz="0.5 0 0"/>
        </joint>
        <link name="bottom_spring_link">
                <visual>
			<material name ="spring"/>
                        <geometry>
                                <cylinder radius="0.3" length= "0.6"/>
                        </geometry>
                        <origin xyz="0 0 0.3" rpy="0 0 0"/>
                </visual>
        </link>

        <joint name="bottom_spring_to_base" type="fixed">
                <parent link="base_link"/>
                <child link="bottom_spring_link"/>
                <origin rpy="0 0 0" xyz="0 0 0.05"/>
        </joint>
	<link name="top_spring_link">
                <visual>
                        <material name ="spring"/>
                        <geometry>
                                <cylinder radius="0.3" length= "0.6"/>
                        </geometry>
                        <origin xyz="0 0 -0.3" rpy="0 0 0"/>
                </visual>
        </link>

        <joint name="top_spring_to_bottom_spring" type="prismatic">
		<axis xyz = "0 0 1"/>
		<limit lower= "0" upper = "0.6" effort = "1000.0" velocity ="1.0"/>
                <parent link="bottom_spring_link"/>
                <child link="top_spring_link"/>
		<origin rpy="0 0 0" xyz="0 0 0.6"/>
	</joint>
	<link name="sphere_link">
                <visual>
                        <geometry>
                                <sphere radius="0.5"/>
                        </geometry>
                        <origin xyz="0 0 0" rpy="0 0 0"/>
                </visual>
        </link>

        <joint name="sphere_to_top_spring" type="fixed">
                <parent link="top_spring_link"/>
                <child link="sphere_link"/>
                <origin rpy="0 0 0" xyz="0 0 0.2"/>
        </joint>

</robot>
